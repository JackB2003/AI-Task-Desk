# Copy to .env (or run `npm run setup`, which writes it for you). Every line is optional.

# Where the web page listens. Keep HOST as 127.0.0.1 unless you put it behind a reverse proxy.
PORT=3025
HOST=127.0.0.1

# Your time zone, used for "due today" and the daily briefing (example: America/New_York).
TIMEZONE=UTC

# Shown in the greeting ("Good morning, Sam"). Optional.
# DISPLAY_NAME=Sam

# --- The AI agent (Claude Code) ---
# Path to the Claude Code program. Default: "claude" from your PATH.
# CLAUDE_BIN=claude
# Folder the agent works in. Anything outside it needs your approval. Default: ./workspace
# AGENT_WORKSPACE=./workspace
# Extra folders the agent may use without asking (comma separated).
# AGENT_ADD_DIRS=
# How the agent pays: "subscription" (your Claude Pro/Max login, default) or "api" (your own key, billed per use).
# AGENT_AUTH=subscription
# ANTHROPIC_API_KEY=
# AGENT_MODEL=
# Longest a single run may take, in milliseconds (default 30 minutes).
# RUN_TIMEOUT_MS=1800000
# Set to 1 to check your plan usage every 15 minutes (costs a few hundred tokens each time).
# USAGE_PING=1

# --- Running behind a reverse proxy (nginx, Caddy) ---
# TRUST_PROXY=1        use X-Real-IP for the visitor address (only when the proxy sets it)
# COOKIE_PATH=/        use /task-desk/ if the app lives under a sub-path
# PUBLIC_URL=https://example.com/task-desk/   link shown in Telegram messages

# --- Public demo mode (see README) ---
# DEMO=1
# DEMO_REPO_URL=https://github.com/JackB2003/ai-task-desk
