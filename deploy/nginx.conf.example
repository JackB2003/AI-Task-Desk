# Example: serve AI Task Desk under /task-desk/ on an existing HTTPS site.
# Run the app with: PORT=3025 COOKIE_PATH=/task-desk/ TRUST_PROXY=1 PUBLIC_URL=https://example.com/task-desk/

location = /task-desk { return 301 /task-desk/; }
location /task-desk/ {
    proxy_pass http://127.0.0.1:3025/;     # the trailing slash strips the /task-desk/ prefix
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 11m;               # attachments are limited to 10 MB
    proxy_read_timeout 60s;
}
